rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: check if authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: check if user is admin (bootstrap UID or verified admin role in users/{uid})
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'bi3c890VUXhVE0JFxroYfnlQwea2' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Helper function: check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection rules:
    // - Administrators can read and manage all user documents
    // - Users can read only their own document
    // - Students CANNOT create accounts or modify role/uid/rfidUID/studentDbId/rollNumber/email
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == 'student' &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.rfidUID == resource.data.rfidUID &&
        request.resource.data.studentDbId == resource.data.studentDbId &&
        request.resource.data.rollNumber == resource.data.rollNumber &&
        request.resource.data.email == resource.data.email
      );
    }

    // Students registry:
    // - Administrators can manage all registered students
    // - Students can only read their own linked student profile
    match /students/{studentId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.authUid == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentDbId == studentId ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rfidUID == studentId)) ||
          ((!('authUid' in resource.data) || resource.data.authUid == '') &&
           resource.data.email is string &&
           request.auth.token.email is string &&
           resource.data.email.lower() == request.auth.token.email.lower())
        )
      );
      allow write: if isAdmin();
    }

    // Attendance records:
    // - Administrators can read and manage all attendance records
    // - Students can only read their own verified attendance entries
    match /attendance/{recordId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.authUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentDbId == resource.data.studentDbId ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rfidUID == resource.data.rfidUID ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rfidUID == resource.data.rfidUid ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rfidUID == resource.data.uid))
        )
      );
      allow write: if isAdmin();
    }
  }
}
